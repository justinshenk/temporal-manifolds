# Google Cloud Storage - needed to upload generated NPZ files
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_PREFIX=

# Use one of the following credential sources.
# GOOGLE_APPLICATION_CREDENTIALS should point to a service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_APPLICATION_CREDENTIALS_JSON can contain the full service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# LLM API keys (optional; used only by some scenario generators / eval scripts)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
